group {
    proxy {
        filter: subtag(subscribe) && name(keyword: 'TW')
        policy: min_moving_avg
        # 按延迟自动选择；无存活节点时回退到 manual 组
        final: manual
    }
    manual {
        filter: name(DEN2, USR3)
        # 固定使用组内第一个节点
        policy: fixed(0)
    }
}

dns {
    # ipversion_prefer: 4
    # 自动推断直连公网路径的 /24；代理上游不会携带生成的 ECS。
    client_subnet: auto

    # hosts 快照:true 加入 /etc/hosts,路径加载 OxiDNS 兼容规则文件;可重复
    use_host: true

    # 独立 DNS 监听器（默认关闭；无认证递归,必须用防火墙限制来源）
    # bind: 'tcp+udp://:1053'

    upstream {
        # local: 'udp://127.0.0.1:53'        
        local: 'udp://223.5.5.5:53' -> direct
        remote: 'tls://dns.google:853' -> proxy
    }
    routing {
        request {
            qname(geosite:gfw) -> remote
            qname(geosite:private) && !qname(geosite:cn) -> local
            fallback: remote
        }
        response {
            upstream(remote) -> accept
            ip(geoip:private) && !qname(geosite:cn) -> accept
            fallback: remote
        }
    }
}

routing {
    # must_direct: DNS 服务、代理客户端、系统服务    
    pname(dnsmasq, systemd-resolved) && l4proto(udp) && dport(53) -> direct(must)
    pname(AdGuardHome) -> direct(must)
    pname(mosdns) -> direct(must)
    pname(NetworkManager) -> direct(must)
    pname(systemd-networkd) -> direct(must)
    pname(systemd-resolved) -> direct(must)
    pname(dhcpcd) -> direct

    # 代理客户端直连（防止回环）
    pname(sing-box, mihomo) -> direct(must)

    # GeoIP 规则
    dip(geoip: private) -> direct(must)
    dip(geoip:cn) -> direct

    # 特定 IP 走代理
    # dip(10.10.10.110) -> proxy

    # 域名代理
    domain(geosite:cn) -> direct
    domain(geosite: google) -> proxy

    # 通用端口代理
    l4proto(udp) && dport(443) -> block
    fallback: proxy
}

experimental {
    clash_api {
        external_controller: '127.0.0.1:9090'
        external_ui: 'ui'
        secret: 'password'
        default_mode: 'Rule'
    }
    cache_file {
        enabled: true
        path: 'cache.db'
        cache_id: ''
        store_fakeip: false
        store_dns: false
    }
}
