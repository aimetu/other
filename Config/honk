# https://github.com/daeuniverse/honk/blob/main/config.dae
# https://github.com/daeuniverse/honk/blob/main/example.dae

global {
    wan_interface: auto    
    lan_interface: br-lan
    
    log_level: info

    # 运行日志追加写入 data_dir 下的文件（空值关闭文件输出）
    log_file: 'honk.log'

    # 拨号模式：ip / domain / domain+ / domain++
    dial_mode: domain
    allow_insecure: false
    auto_config_kernel_parameter: true

    # 运行时状态与相对资源根目录（须为绝对路径；修改后需重启）
    data_dir: '/var/lib/honk'

    # 健康检查：TCP 用 HTTPS 探测，UDP 用 DNS 探测（经节点自身隧道）
    tcp_check_url: 'https://www.gstatic.com/generate_204'
    tcp_check_http_method: HEAD
    udp_check_dns: 'dns.google.com:53,8.8.8.8,2001:4860:4860::8888'
    check_interval: 300s
    check_tolerance: 50ms

    # 预热与拨号预算（详细语义见 doc/zh/configuration.md）：
    # - 健康探测只测不暖:探测不会给冷节点留下常驻会话,无需担心节点多。
    # - UDP 预热：每组每 IP 族 top-N 个 UDP 叶子预建会话（单组封顶 3，
    #   进程总量封顶 4×N；大订阅建议 N=1-3）。
    # udp_warm_node_count: 3

    # - 启动裸 TCP 预连接:'auto'(默认,最多 8 个,各组当前选中优先)
    #   / 0(关闭) / N;AnyTLS/QUIC 与内置 direct/block 自动排除。
    # preconnect_node_count: 'auto'

    # 物理代理连接/握手并发上限（默认 64；Ready/已热复用及 direct/block 不占额度）
    # max_concurrent_dials: 64

    bootstrap_resolver: '223.5.5.5:53'

    fallback_resolver: '1.1.1.1:53'

    # 保存成功获取的订阅正文到运行目录 .sub,启动/重载时可离线恢复
    store_subscribe: true

    # 持有有歧义 LAN 转发 UDP 首包；默认开启，修改后需重启。
    nfqueue_enable: true

    # 预热与拨号预算(小中规模节点的推荐值;大订阅见 doc/zh/configuration.md)
    # 大订阅基线关闭额外 UDP 预热；Selector 选择仍单独保活。
    udp_warm_node_count: 0

    # 大订阅诊断基线也关闭启动裸 TCP 预连接。
    preconnect_node_count: 0

    # 物理代理连接/握手上限（默认 64；Ready/已热复用和 direct/block 不占额度）
    # max_concurrent_dials: 64

    tproxy_port: 12345
    tproxy_port_protect: true
    pprof_port: 0
    bpf_conn_state_map_size: 262144
    so_mark_from_dae: 0
    
    disable_waiting_network: false
    disable_thp: false

    sniffing_timeout: 100ms
    tls_implementation: tls
    utls_imitate: chrome_auto
    tls_fragment: false
    tls_fragment_length: '50-100'
    tls_fragment_interval: '10-20'
    mptcp: false
    bandwidth_max_tx: '200 mbps'
    bandwidth_max_rx: '1 gbps'
}

subscription {
    subscribe: 'https://example.com/subscribe/'(honk/1.0 like)
}

node {
    # iris-1: ''socks5://user:pass@gw.example.com:1080''    
    DEN2: 'vless://5e7b8799-1f03-4c3a-911f-7ce6911483c9@2.58.196.42:22703?encryption=none&security=tls&sni=de.aimeto.ggff.net&fp=chrome&alpn=h2%2Chttp%2F1.1&insecure=0&allowInsecure=0&type=grpc&authority=&serviceName=den2&mode=gun#%F0%9F%87%A9%F0%9F%87%AA%20%E5%BE%B7%E5%9B%BDN2'
    DEN2C: 'vless://5e7b8799-1f03-4c3a-911f-7ce6911483c9@de.aimeto.ggff.net:2087?encryption=none&security=tls&sni=de.aimeto.ggff.net&fp=chrome&alpn=h2%2Chttp%2F1.1&insecure=0&allowInsecure=0&type=grpc&authority=&serviceName=den2&mode=gun#%F0%9F%87%A9%F0%9F%87%AA%20%E5%BE%B7%E5%9B%BDN2C'
